# Copy to .env.docker and fill in real values.
# Used only by docker-compose (postgres/pgadmin/caddy) — not read by the app itself.

# --- Postgres ---
POSTGRES_USER=rr_database
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=rr_database

# --- pgAdmin4 login ---
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=CHANGE_ME

# --- Domain ---
# Must already have a DNS A record pointing at this server before starting
# the caddy container, or Let's Encrypt issuance will fail. pgAdmin4 is
# served at APP_DOMAIN/pgadmin (see Caddyfile) — no separate subdomain/DNS
# record needed for it.
APP_DOMAIN=rr-database.example.com
LETSENCRYPT_EMAIL=you@example.com
