# Copy to .env.local and fill in real values. Never commit .env.local.

# Postgres connection string.
# Local dev: postgresql://USER:PASSWORD@localhost:5432/rr_database
# Docker: overridden automatically by docker-compose from .env.docker, leave as-is.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/rr_database

# Random secret used to sign session cookies. Generate one with:
#   openssl rand -base64 32
SESSION_SECRET_KEY=CHANGE_ME

# Encrypts user-contributed OpenAlex/Groq API keys at rest (src/lib/apiKeyEncryption.ts).
# Must decode to exactly 32 bytes. Generate one with:
#   openssl rand -base64 32
# Changing this after keys have been saved makes them undecryptable — users
# will need to re-enter their keys on the Account page.
API_KEY_ENCRYPTION_KEY=CHANGE_ME
