# Copy to .env and fill in real values. Never commit .env.
# See README.md for how to obtain a Zotero API key.

# Production library (public)
ZOTERO_API_KEY=YOUR_API_KEY
ZOTERO_LIBRARY_TYPE=group
ZOTERO_LIBRARY_ID=5937153

# Staging library (private, shared — where HitL review happens)
ZOTERO_STAGING_API_KEY=YOUR_API_KEY
ZOTERO_STAGING_LIBRARY_TYPE=group
ZOTERO_STAGING_LIBRARY_ID=6373812

# Optional shared fallback key for OpenAlex enrichment. Pooled together with
# any keys users add on their Account page (src/lib/apiKeyPool.ts) and
# round-robined across requests. Safe to leave unset — enrichment falls back
# to unauthenticated OpenAlex calls.
OPENALEX_API_KEY=
